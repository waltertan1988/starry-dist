<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.7</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.walter.starry</groupId>
	<artifactId>starry-server-parent</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>starry-server-parent</name>
	<description>Starry Project</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java.version>21</java.version>
		<guava.version>32.1.2-jre</guava.version>
		<commons-lang3.version>3.13.0</commons-lang3.version>
		<commons-collections4.version>4.4</commons-collections4.version>
		<redisson.version>3.26.0</redisson.version>
		<mybatis-spring-boot-starter.version>4.0.1</mybatis-spring-boot-starter.version>
		<pagehelper-spring-boot-starter.version>2.1.0</pagehelper-spring-boot-starter.version>
		<rocketmq-spring-boot-starter.version>2.3.3</rocketmq-spring-boot-starter.version>
		<spring-ai.version>2.0.0</spring-ai.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Starry系统的核心依赖 -->
			<dependency>
				<groupId>com.walter.starry</groupId>
				<artifactId>starry-common-lib</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.walter.starry</groupId>
				<artifactId>starry-authorization-server-spring-boot-autoconfigure</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.walter.starry</groupId>
				<artifactId>starry-security-spring-boot-autoconfigure</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.walter.starry</groupId>
				<artifactId>starry-mdc-spring-boot-autoconfigure</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.walter.starry</groupId>
				<artifactId>starry-ai-spring-boot-autoconfigure</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Starry二方API依赖 -->
			<dependency>
				<groupId>com.walter.starry</groupId>
				<artifactId>starry-mcp-server-remote</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!--AI相关-->
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<modules>
		<module>mybatis-generator</module>
		<module>starry-common-lib</module>
		<module>starry-mcp-server-remote</module>
		
		<module>starry-authorization-server-spring-boot-autoconfigure</module>
		<module>starry-security-spring-boot-autoconfigure</module>
		<module>starry-mdc-spring-boot-autoconfigure</module>
		<module>starry-ai-spring-boot-autoconfigure</module>
	
		<module>starry-business-app</module>
		<module>starry-authorization-server-app</module>
		<module>starry-mcp-server-app</module>
	</modules>
</project>
